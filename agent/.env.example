# ──────────────────────────────────────────────────────────────
# Supabase project credentials
# Get these from: Supabase Dashboard → Settings → API
# ──────────────────────────────────────────────────────────────

# Project URL (looks like https://xxxxx.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Service Role Key (secret, never expose in frontend!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-key-here

# ──────────────────────────────────────────────────────────────
# Postgres connection string (for run_schema.py via psycopg2)
# Get from: Supabase Dashboard → Settings → Database → Connection string
# Select "Transaction" or "Session" mode, copy the full URI
# ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your-db-password@db.xxxxx.supabase.co:5432/postgres
